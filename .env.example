# =========================================================
# Яндекс.Карты — карта зон доставки и автоподсказки адреса
# =========================================================
# Ключ пакета «JavaScript API» из кабинета разработчика:
#   https://developer.tech.yandex.ru/services/  → «Подключить API» → JavaScript API
# В настройках ключа заполните «Ограничение по HTTP Referer»:
#   ваш домен, *.домен и localhost.
# Префикс NEXT_PUBLIC_ обязателен — карта работает в браузере.

NEXT_PUBLIC_YANDEX_MAPS_API_KEY=ВСТАВЬТЕ_КЛЮЧ_СЮДА


# =========================================================
# Pizzagram → Telegram (заказы при получении)
# =========================================================
# Создайте бота через @BotFather, добавьте его в нужный чат/группу,
# узнайте chat_id через https://api.telegram.org/bot<TOKEN>/getUpdates
# и заполните значения ниже. Без них заказы будут писаться в server console.

TELEGRAM_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_СЮДА
TELEGRAM_CHAT_ID=ВСТАВЬТЕ_CHAT_ID_СЮДА


# =========================================================
# ЮКасса — онлайн-оплата картой и СБП
# =========================================================
# Берётся из личного кабинета ЮКассы (yookassa.ru):
#   Настройки → Интеграция → API-ключи
#   shopId — 6-значный идентификатор магазина (не секрет)
#   secretKey — начинается на live_ (боевой) или test_ (тест)
#
# В ЛК ЮКассы укажите URL уведомлений (HTTP-уведомления):
#   https://<ваш_домен>/api/payment-webhook
#
# NEXT_PUBLIC_SITE_URL — полный URL сайта без слэша на конце.
# Используется как return_url после оплаты.
# На локале — http://localhost:3000; на проде — https://вашдомен.ru
#
# Если переменные не заданы — кнопка «Онлайн» в чекауте сработает в режиме
# симуляции (заказ уйдёт в Telegram с пометкой «не оплачен»).

YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=live_ВСТАВЬТЕ_КЛЮЧ
NEXT_PUBLIC_SITE_URL=https://вашдомен.ru


# =========================================================
# Google Gemini — ИИ-помощник по выбору пиццы (Фича 7)
# =========================================================
# Бесплатный ключ из Google AI Studio:
#   https://aistudio.google.com  → «Get API key» → «Create API key»
# Карта не нужна, бесплатный тариф включается сразу (есть лимиты запросов).
#
# Если переменная не задана — кнопка ИИ-помощника покажет
# «AI-помощник не настроен», остальной сайт работает как обычно.

GEMINI_API_KEY=ВСТАВЬТЕ_КЛЮЧ_СЮДА

# Gemini API geo-блокирует часть регионов (в т.ч. РФ). Node.js на сервере
# не использует системный прокси, поэтому для локальной разработки из такого
# региона укажите адрес локального прокси-клиента, напр. http://127.0.0.1:10809
# ВАЖНО: на зарубежном хостинге (Vercel и т.п.) переменную НЕ задавайте —
# запросы пойдут напрямую. На российском хостинге Gemini работать не будет.
GEMINI_PROXY_URL=
